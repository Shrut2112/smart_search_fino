cy lies elsewhere in the system and you notify us \nwithin three working days of receiving the communication from us regarding the unauthorized', 'text_hash': 'ad932c7f077eee8f9c8253d58bed701d', 'quality_score': 0.37120000000000003, 'metadata': {'doc_id': 'code_of_banks_commitment_to_customers_0', 'normalized_filename': 'code_of_banks_commitment_to_customers_0_v1.pdf', 'content_hash': '5eddba6c22d2fe3b46db023ae68d5183a15cb235b4d6713a96971ab80c02520f', 'extraction_stats': {'total_pages': 11, 'text_blocks': 11, 'table_blocks': 0, 'raw_chars': 0, 'ocr_pages': 0, 'extraction_timestamp': '2026-02-19T12:14:57.818895', 'total_chars_post_clean': 44536}, 'language': 'en', 'has_tables': False, 'cleaned_timestamp': '2026-02-19T12:15:07.955650', 'chunk_type': 'text', 'page_number': 21, 'chunk_index': 48, 'is_table': False}, 'embedding': [0.029458222910761833, 0.017148088663816452, -0.005074802786111832, 0.011754275299608707, 0.014724158681929111, -0.05473478138446808, -0.027951348572969437, -0.033223528414964676, 0.02110850065946579, 0.03891078755259514, 0.007843845523893833, 0.0027663290966302156, 0.10885405540466309, 0.020846450701355934, -0.04870930686593056, -0.04219570755958557, 0.038857344537973404, -0.01805436983704567, 0.029705550521612167, -0.02943604253232479, 0.03927759453654289, -0.027555041015148163, 0.04107829928398132, -0.025586744770407677, 0.027828464284539223, -0.046307310461997986, -0.03461454436182976, 0.039017610251903534, -0.008312216959893703, 0.029809076339006424, 0.03880278766155243, -0.027328945696353912, -0.014874158427119255, 0.03447035327553749, 0.02817368321120739, 0.04026668146252632, -0.005495893768966198, -0.02625126764178276, 0.00014898540393915027, 0.023887209594249725, -0.020270612090826035, 0.04758187010884285, 0.02671625092625618, -0.04619840160012245, 0.015620929189026356, -0.030164023861289024, 0.02770541049540043, -0.0032775236759334803, -0.022565919905900955, -0.012883523479104042, 0.054229915142059326, 0.039523787796497345, 0.050304077