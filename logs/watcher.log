olicy document.\n• Frequently asked questions', 'text_hash': 'dab1ebb58ff1750949d67dbf1f047809', 'quality_score': 0.3056, 'metadata': {'doc_id': 'customer_grievance_policy_0', 'normalized_filename': 'customer_grievance_policy_0_v1.pdf', 'content_hash': '785b00f9107f2c85c2912b96e5e471adf57b5ee7ff067aac98d5142dd58ca60b', 'extraction_stats': {'total_pages': 13, 'text_blocks': 13, 'table_blocks': 0, 'raw_chars': 0, 'ocr_pages': 0, 'extraction_timestamp': '2026-02-19T11:59:41.082010', 'total_chars_post_clean': 30055}, 'language': 'en', 'has_tables': False, 'cleaned_timestamp': '2026-02-19T11:59:53.321368', 'chunk_type': 'text', 'page_number': 3, 'chunk_index': 4, 'is_table': False}, 'embedding': [0.02984457276761532, 0.025314683094620705, -0.017543913796544075, 0.01743578352034092, 0.007198581472039223, -0.06314223259687424, -0.011866702698171139, -0.03500721603631973, 0.01634730026125908, 0.040289800614118576, -0.0217962134629488, 0.006579584442079067, 0.09924594312906265, 0.03720800578594208, -0.028811855241656303, -0.03314727917313576, 0.033116087317466736, -0.01660202257335186, 0.03741416707634926, -0.005124668590724468, 0.032332681119441986, -0.03573497012257576, 0.052389055490493774, -0.010502452030777931, 0.04389296472072601, -0.04138275235891342, -0.017404256388545036, 0.06452677398920059, -0.01448130514472723, 0.0563536211848259, 0.01344709936529398, -0.04100370034575462, 0.0051867044530808926, 0.009783956222236156, 0.03226391226053238, 0.03974013030529022, -0.029549190774559975, -0.037034377455711365, 0.010155469179153442, 0.039939191192388535, 0.028693493455648422, 0.040046002715826035, 0.013174278661608696, -0.04536515846848488, 0.02526015043258667, -0.03467807546257973, 0.05484184995293617, 0.020078478381037712, 0.004238946363329887, -0.0483563058078289, 0.015011717565357685, 0.017923541367053986, 0.0387628898024559, 0.04050104320049286, -0.050669144839048386, -0.017293790355324745, 0.012791972607374191, 0.046181634068489075, -0.027249960228800774, 0.0633578