pecified\ntimelines, the complaint is escalated to a higher authority. In case the customer is not satisfied', 'text_hash': 'b9fb67f69d627ec82bbeb0ff978af36b', 'quality_score': 0.32480000000000003, 'metadata': {'doc_id': 'customer_grievance_policy_0', 'normalized_filename': 'customer_grievance_policy_0_v1.pdf', 'content_hash': '785b00f9107f2c85c2912b96e5e471adf57b5ee7ff067aac98d5142dd58ca60b', 'extraction_stats': {'total_pages': 13, 'text_blocks': 13, 'table_blocks': 0, 'raw_chars': 0, 'ocr_pages': 0, 'extraction_timestamp': '2026-02-19T12:15:44.236550', 'total_chars_post_clean': 30055}, 'language': 'en', 'has_tables': False, 'cleaned_timestamp': '2026-02-19T12:15:58.185820', 'chunk_type': 'text', 'page_number': 5, 'chunk_index': 11, 'is_table': False}, 'embedding': [0.024040672928094864, 0.04446368291974068, 0.0027357323560863733, 0.030602820217609406, -6.441198638640344e-05, -0.011882983148097992, -0.0017538744723424315, -0.04607025161385536, 0.014891773462295532, 0.015330621041357517, 0.005175486672669649, -0.020632483065128326, 0.11087499558925629, 0.0408935546875, -0.043574947863817215, -0.028291525319218636, 0.02088155783712864, -0.009013831615447998, 0.03320183604955673, -0.025452284142374992, 0.01720547489821911, -0.0362420417368412, 0.021757569164037704, -0.000941041624173522, 0.013157871551811695, -0.02212037518620491, -0.0057758004404604435, 0.03518714755773544, 0.012531369924545288, 0.07027040421962738, 0.038029108196496964, -0.019981782883405685, 0.016787700355052948, 0.026896879076957703, 0.011081011034548283, 0.033807847648859024, -0.025661133229732513, -0.05088067054748535, 0.018682751804590225, 0.025579404085874557, 0.02043670043349266, 0.03204774111509323, 0.025008052587509155, -0.03950226306915283, 0.019015265628695488, -0.013734949752688408, 0.05573378503322601, 0.0041836644522845745, -0.042837366461753845, -0.027345940470695496, 0.018489181995391846, 0.04234951734542847, 0.04395345598459244, 0.040131572633981705, -0.013220285065472126, -0.035928