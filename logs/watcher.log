 comply with such instructions/directions issued by RBI from time', 'text_hash': 'f6fc3f6a581d968b73c4f0df3e5eeba0', 'quality_score': 0.3104, 'metadata': {'doc_id': 'code_of_banks_commitment_to_customers_0', 'normalized_filename': 'code_of_banks_commitment_to_customers_0_v1.pdf', 'content_hash': '5eddba6c22d2fe3b46db023ae68d5183a15cb235b4d6713a96971ab80c02520f', 'extraction_stats': {'total_pages': 11, 'text_blocks': 11, 'table_blocks': 0, 'raw_chars': 0, 'ocr_pages': 0, 'extraction_timestamp': '2026-02-19T13:02:47.537246', 'total_chars_post_clean': 44536}, 'language': 'en', 'has_tables': False, 'cleaned_timestamp': '2026-02-19T13:03:06.853245', 'chunk_type': 'text', 'page_number': 4, 'chunk_index': 4, 'is_table': False}, 'embedding': [-0.002155472757294774, 0.0697229728102684, -0.03050236776471138, 0.005601790733635426, 0.06324081867933273, -0.03925832733511925, -0.023059679195284843, -0.03707015514373779, -0.004285010509192944, -0.011624970473349094, 0.005863748956471682, 0.007319180760532618, 0.09751420468091965, -0.00043514749268069863, -0.03500951826572418, -0.002695954404771328, 0.02351452223956585, -0.011962592601776123, 0.04297170042991638, -0.006295366212725639, 0.007963733747601509, 0.004288152325898409, 0.02848661132156849, -0.053291771560907364, 0.0009987798985093832, -0.024637550115585327, -0.008865650743246078, 0.049427349120378494, -0.005155312363058329, 0.052989352494478226, 0.02137555368244648, -0.03488718718290329, -0.005955270957201719, 0.02685946598649025, 0.020810352638363838, 0.025697167962789536, 0.0019744830206036568, -0.043017227202653885, 0.011277759447693825, 0.03892022371292114, 0.01350885909050703, 0.03978923708200455, 0.013800700195133686, -0.018196113407611847, 0.05420346558094025, -0.009495565667748451, 0.03333060070872307, 0.0038844982627779245, -0.03439048305153847, 0.01603384129703045, 0.05735519155859947, 0.002727614948526025, 0.034750111401081085, 0.05213393643498421, -0.054137881845235825, -0.021019188687205315, 0.029019480571150