 reason for giving information about you or your accounts \n(including your name and address) to anyone else, including other companies in our \ngroup, for marketing purposes. \n• \nIf you authorize us to reveal the information. \n• \nIf we are asked to give a banker’s reference about you, we will need your written \npermission before we give it. \n• \nWe will not use your personal information for marketing purposes by anyone including \nourselves unless you specifically authorize us to do so.', 'text_hash': '0fd738dd1649e40130e1199704bc603e', 'quality_score': 0.49119999999999997, 'metadata': {'doc_id': 'code_of_banks_commitment_to_customers_0', 'normalized_filename': 'code_of_banks_commitment_to_customers_0_v1.pdf', 'content_hash': '5eddba6c22d2fe3b46db023ae68d5183a15cb235b4d6713a96971ab80c02520f', 'extraction_stats': {'total_pages': 11, 'text_blocks': 11, 'table_blocks': 0, 'raw_chars': 0, 'ocr_pages': 0, 'extraction_timestamp': '2026-02-19T11:59:00.255942', 'total_chars_post_clean': 44536}, 'language': 'en', 'has_tables': False, 'cleaned_timestamp': '2026-02-19T11:59:07.335642', 'chunk_type': 'text', 'page_number': 19, 'chunk_index': 43, 'is_table': False}, 'embedding': [-0.0013141881208866835, 0.029347289353609085, -0.010538127273321152, 0.0024500489234924316, 0.03351086005568504, -0.019968105480074883, -0.030918139964342117, -0.034548256546258926, -0.000774701067712158, 0.01719815470278263, -0.01370407547801733, 0.005275207106024027, 0.11630633473396301, 0.01208208967000246, -0.04129481315612793, -0.01631329022347927, 0.0422099232673645, -0.03214006870985031, 0.01922612078487873, -0.0008994158706627786, 0.04944147914648056, -0.03724007308483124, 0.03059176169335842, -0.027724837884306908, 0.030572883784770966, -0.02545168809592724, 0.009960919618606567, 0.041979845613241196, -0.012994385324418545, 0.06633615493774414, 0.024113979190587997, -0.04517809674143791, 0.007368853781372309, 0.019303712993860245, 0.04876213148236275, 0.03468034788966179, 0.0100069520995